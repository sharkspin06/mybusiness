{
  "name": "mybusiness",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @mybusiness/web",
    "dev:api": "npm run dev -w @mybusiness/api",
    "build": "npm run build -w @mybusiness/shared && npm run build -w @mybusiness/web && npm run build -w @mybusiness/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run migrate -w @mybusiness/api",
    "db:seed": "npm run seed -w @mybusiness/api"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true
  }
}
